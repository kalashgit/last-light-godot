extends RefCounted
## Searchable spawn catalog (GM00 Mission 3). Data: data/sandbox/spawn_catalog_v1.json,
## generated by tools/build_spawn_catalog.py from the F01-F10 queues.
## Entries are PROVISIONAL; canonical_asset_id is always null until A00 reconciles.

const CATALOG_PATH := "res://data/sandbox/spawn_catalog_v1.json"

var data: Dictionary = {}
var by_id: Dictionary = {}

func load_catalog(path: String = CATALOG_PATH) -> bool:
    by_id.clear()
    if not FileAccess.file_exists(path):
        return false
    var parsed: Variant = JSON.parse_string(FileAccess.get_file_as_string(path))
    if not parsed is Dictionary or parsed.get("schema", "") != "last_light.spawn_catalog.v1":
        return false
    data = parsed
    for entry in data.get("entries", []):
        by_id[str(entry["spawn_id"])] = entry
    return not by_id.is_empty()

func categories() -> Array:
    return data.get("categories", [])

func get_entry(spawn_id: String) -> Dictionary:
    return by_id.get(spawn_id, {})

## Case-insensitive search over name, spawn id, family and candidate key.
## Empty query returns every entry in the category ("" = all categories).
func search(query: String, category: String = "") -> Array:
    var q: String = query.strip_edges().to_lower()
    var out: Array = []
    for entry in data.get("entries", []):
        if not category.is_empty() and str(entry["category"]) != category:
            continue
        if q.is_empty():
            out.append(entry)
            continue
        var hay: String = (str(entry["name"]) + " " + str(entry["spawn_id"]) + " " + str(entry.get("family", "")) + " " + str(entry.get("candidate_key", ""))).to_lower()
        if q in hay:
            out.append(entry)
    return out

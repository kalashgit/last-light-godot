class_name Models
extends RefCounted
## Box models (rot 0, front faces +y) for every furniture / prop object.
## Box = [x0,y0,z0,x1,y1,z1,Color,material]; x,y in tiles, z in pixels.

static func b(x0: float, y0: float, z0: float, x1: float, y1: float, z1: float, hex: String, m: int = 0) -> Array:
	return [x0, y0, z0, x1, y1, z1, Color(hex), m]

static func legs(x0: float, y0: float, x1: float, y1: float, z: float, hex: String, t: float = 0.07) -> Array:
	return [b(x0, y0, 0, x0 + t, y0 + t, z, hex), b(x1 - t, y0, 0, x1, y0 + t, z, hex),
		b(x0, y1 - t, 0, x0 + t, y1, z, hex), b(x1 - t, y1 - t, 0, x1, y1, z, hex)]

static func car(body: String, glass: String, wreck: bool) -> Array:
	var P := Painter
	var bm: int = P.M_RUST if wreck else P.M_METAL
	var out: Array = [
		b(.12, .45, 0, .34, 1.1, 10, "1c1c1e"), b(1.66, .45, 0, 1.88, 1.1, 10, "1c1c1e"),
		b(.12, 2.85, 0, .34, 3.5, 10, "1c1c1e"), b(1.66, 2.85, 0, 1.88, 3.5, 10, "1c1c1e"),
		b(.16, .16, 5, 1.84, 3.84, 20, body, bm),
		b(.26, 1.0, 20, 1.74, 2.85, 33, body, bm),
		b(.16, 3.84, 5, 1.84, 3.9, 9, "777a7c"), b(.16, .1, 5, 1.84, .16, 9, "777a7c"),
	]
	if not wreck:
		out.append_array([
			b(1.74, 1.1, 22, 1.76, 2.75, 31, glass, P.M_GLASS), b(.34, 2.85, 22, 1.66, 2.87, 31, glass, P.M_GLASS),
			b(.34, .98, 22, 1.66, 1.0, 31, glass, P.M_GLASS), b(.24, 1.1, 22, .26, 2.75, 31, glass, P.M_GLASS),
			b(.24, 3.9, 12, .56, 3.92, 16, "f2e6a8"), b(1.44, 3.9, 12, 1.76, 3.92, 16, "f2e6a8"),
			b(.24, .08, 12, .56, .1, 16, "b83a30"), b(1.44, .08, 12, 1.76, .1, 16, "b83a30"),
			b(1.84, 1.75, 14, 1.86, 1.95, 16, "333333"),
		])
	else:
		out.append_array([
			b(1.74, 1.1, 22, 1.76, 2.75, 31, "151515"), b(.34, 2.85, 22, 1.66, 2.87, 31, "151515"),
			b(.34, .98, 22, 1.66, 1.0, 31, "151515"),
		])
	return out


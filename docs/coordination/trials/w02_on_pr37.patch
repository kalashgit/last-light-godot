+func roundtrip_state() -> Dictionary:
+	return {"vitals": game.vitals.snapshot(), "survival": game.survival.snapshot(), "contents": game.container_contents.duplicate(true),
+		"drops": game.drops.duplicate(true), "player": game.player}

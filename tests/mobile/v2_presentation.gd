extends SceneTree
## W08 checks for the Production Integration V2 presentation adapter.
## Part 1 uses a deterministic synthetic atlas generated in memory (not an asset).
## Part 2 runs on the real F12 calibration fixture when it has been generated by
## tests/godot_fixture/prepare_fixture.py (PR #53 / CI); otherwise it is reported
## as NOT RUN, never as passed.
##   godot --headless --path . --script tests/mobile/v2_presentation.gd

const Presenter := preload("res://scripts/mobile/v2_sprite_presenter.gd")
const REAL_FIXTURE := "res://tests/godot_fixture/generated/"
var failures: Array[String] = []
var passes := 0


func _initialize() -> void:
	call_deferred("run")


func check(condition: bool, label: String) -> void:
	if condition:
		passes += 1
	else:
		failures.append(label)
		printerr("FAIL: " + label)


func synthetic() -> Dictionary:
	# Four 64x64 frames; an opaque body moves inside a stable canvas, feet at (32,56).
	var atlas := Image.create(128, 128, false, Image.FORMAT_RGBA8)
	atlas.fill(Color(0, 0, 0, 0))
	var frames: Array = []
	for i in range(4):
		var origin := Vector2i(i % 2 * 64, i / 2 * 64)
		atlas.fill_rect(Rect2i(origin + Vector2i(24 + i * 2, 20), Vector2i(12, 37)), Color(0.4 + i * .1, .5, .3, 1))
		frames.append({"heading": i, "source_frame": 1, "rect": [origin.x, origin.y, 64, 64], "ground_pivot_px": [32, 56], "duration_ms": 100})
	return {"atlas": atlas, "info": {"frames": frames}}


func test_gate() -> void:
	var calibration := {"approval_status": "CALIBRATION_ONLY", "logical_tile_px": [80, 40]}
	check(Presenter.gate(calibration, Presenter.CONTEXT_FIXTURE) == "", "gate: calibration allowed in isolated fixture")
	check(Presenter.gate(calibration, Presenter.CONTEXT_GAME).begins_with("BLOCKED_NOT_APPROVED"), "gate: calibration blocked from gameplay")
	var forged := {"approval_status": "GODOT_INTEGRATION_APPROVED", "logical_tile_px": [80, 40]}
	check(Presenter.gate(forged, Presenter.CONTEXT_GAME).begins_with("BLOCKED_RECEIPT"), "gate: approval status alone is not enough")
	var wrong_tile := {"approval_status": "CALIBRATION_ONLY", "logical_tile_px": [64, 32]}
	check(Presenter.gate(wrong_tile, Presenter.CONTEXT_FIXTURE).begins_with("BLOCKED_PROJECTION"), "gate: wrong projection blocked")
	check(Presenter.gate({}, Presenter.CONTEXT_FIXTURE) != "", "gate: empty manifest blocked")
	check(Presenter.gate(calibration, "main").begins_with("BLOCKED_CONTEXT"), "gate: unknown context blocked")
	var receipt := {"package_id": "x", "package_sha256": "y", "ledger_commit": "z", "w09_evidence": "u", "founder_evidence": "v"}
	var complete := {"approval_status": "GODOT_INTEGRATION_APPROVED", "logical_tile_px": [80, 40], "integration_receipt": receipt}
	check(Presenter.gate(complete, Presenter.CONTEXT_GAME) == "", "gate: shape of a complete future receipt is accepted")


func test_trim_and_pivot() -> void:
	var data := synthetic()
	var atlas: Image = data.atlas
	var subject := Presenter.build_subject(atlas, data.info)
	check(not subject.has("error"), "trim: synthetic subject builds")
	var trim: Rect2i = subject.trim
	check(trim == Rect2i(24, 20, 18, 37), "trim: union of alpha bounds over all frames (%s)" % [trim])
	var first: Vector2 = subject.pivots[0]
	for i in range(4):
		check(subject.pivots[i] == first, "trim: ground pivot identical for frame %d" % i)
		var region: Rect2i = subject.regions[i]
		var packed: Image = subject.texture.get_image()
		var r: Array = data.info.frames[i].rect
		for probe in [Vector2i(0, 0), Vector2i(5, 10), trim.size - Vector2i.ONE]:
			var original := atlas.get_pixel(int(r[0]) + trim.position.x + probe.x, int(r[1]) + trim.position.y + probe.y)
			check(packed.get_pixelv(region.position + probe).is_equal_approx(original), "trim: frame %d pixel %s copied exactly" % [i, probe])
	check(subject.packed_bytes < subject.source_bytes, "memory: repacked atlas smaller (%d < %d bytes)" % [subject.packed_bytes, subject.source_bytes])
	var sprite := AnimatedSprite2D.new()
	sprite.position = Vector2(200, 300)
	Presenter.configure_sprite(sprite, subject)
	# Ground pivot pixel in canvas space must land exactly on sprite.position.
	var pivot_canvas: Vector2 = sprite.position + sprite.offset + subject.pivots[0]
	check(pivot_canvas == sprite.position, "pivot: feet land on the ground point")
	check(sprite.texture_filter == CanvasItem.TEXTURE_FILTER_NEAREST, "pivot: crisp nearest filtering")
	sprite.free()


func test_heading() -> void:
	check(Presenter.heading_for(Vector2.RIGHT, 8, {}) == -1, "heading: no F12 convention published -> no guess")
	var convention := {"heading_zero_world_deg": 0.0, "clockwise": true}
	check(Presenter.heading_for(Vector2.RIGHT, 8, convention) == 0, "heading: zero direction")
	check(Presenter.heading_for(Vector2.DOWN, 8, convention) == 2, "heading: quarter turn clockwise")
	check(Presenter.heading_for(Vector2.LEFT, 16, convention) == 8, "heading: half turn of 16")
	check(Presenter.heading_for(Vector2.UP, 1, convention) == 0, "heading: single-view object")


func test_real_fixture() -> String:
	var manifest := Presenter.load_manifest(REAL_FIXTURE + "fixture_manifest.json")
	if manifest.is_empty():
		return "NOT_RUN (generate with tests/godot_fixture/prepare_fixture.py from PR #53)"
	check(Presenter.gate(manifest, Presenter.CONTEXT_FIXTURE) == "", "real: calibration manifest accepted only as fixture")
	check(Presenter.gate(manifest, Presenter.CONTEXT_GAME) != "", "real: calibration manifest blocked from gameplay")
	var report := {}
	var total_source := 0
	var total_packed := 0
	var frame_count := 0
	for name in manifest.get("cases", {}).keys():
		var info: Dictionary = manifest.cases[name]
		var image := Image.new()
		var error := image.load(REAL_FIXTURE + str(info.atlas))
		check(error == OK, "real: %s atlas loads" % name)
		if error != OK:
			continue
		var subject := Presenter.build_subject(image, info)
		check(not subject.has("error"), "real: %s presents" % name)
		if subject.has("error"):
			continue
		var unique_pivots := {}
		for p in subject.pivots:
			unique_pivots[p] = true
		frame_count += info.frames.size()
		total_source += subject.source_bytes
		total_packed += subject.packed_bytes
		report[name] = {
			"frames": info.frames.size(),
			"atlas_px": info.size,
			"trim_px": [subject.trim.size.x, subject.trim.size.y],
			"packed_px": [subject.packed_size.x, subject.packed_size.y],
			"rgba8_bytes_before": subject.source_bytes,
			"rgba8_bytes_after": subject.packed_bytes,
			"distinct_ground_pivots": unique_pivots.size(),
		}
		check(subject.packed_bytes <= subject.source_bytes, "real: %s repack never grows memory" % name)
	check(frame_count == 40, "real: all 40 F12 calibration frames presented (%d)" % frame_count)
	print("W08_V2_FIXTURE: " + JSON.stringify({"status": "PRESENTED_CALIBRATION_ONLY", "approval": "NOT_GOLDEN_OR_PRODUCTION",
		"frames": frame_count, "rgba8_bytes_before": total_source, "rgba8_bytes_after": total_packed, "subjects": report}))
	return "RUN"


func run() -> void:
	test_gate()
	test_trim_and_pivot()
	test_heading()
	var real := test_real_fixture()
	if failures.is_empty():
		print("W08 V2 PRESENTATION: %d checks PASS; real F12 fixture: %s" % [passes, real])
		quit(0)
	else:
		printerr("W08 V2 PRESENTATION: %d FAILED" % failures.size())
		quit(1)

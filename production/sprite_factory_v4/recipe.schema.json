{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LAST LIGHT V4 native inventory recipe",
  "type": "object",
  "required": [
    "id",
    "family",
    "archetype",
    "materials",
    "parts"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)*$"
    },
    "family": {
      "type": "string",
      "pattern": "^[a-z0-9_]+$"
    },
    "archetype": {
      "enum": [
        "backpack",
        "bag",
        "bar",
        "bottle",
        "box",
        "can",
        "case",
        "flashlight",
        "fruit",
        "gloves",
        "hammer",
        "hat",
        "layered",
        "mug",
        "plank",
        "radio",
        "rope",
        "screwdriver",
        "tape",
        "wrench"
      ]
    },
    "design": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "bare_steel",
          "painted_metal",
          "aluminum",
          "plastic",
          "glass",
          "rubber",
          "wood",
          "leather",
          "fabric",
          "paper",
          "ceramic",
          "organic",
          "stone",
          "liquid"
        ]
      }
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "name",
          "material",
          "construction"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "material": {
            "enum": [
              "bare_steel",
              "painted_metal",
              "aluminum",
              "plastic",
              "glass",
              "rubber",
              "wood",
              "leather",
              "fabric",
              "paper",
              "ceramic",
              "organic",
              "stone",
              "liquid"
            ]
          },
          "construction": {
            "type": "string"
          }
        }
      }
    },
    "view": {
      "const": "inventory_icon"
    },
    "state": {
      "const": "intact"
    },
    "camera": {
      "const": "inventory_3q"
    },
    "size": {
      "const": [
        64,
        64
      ]
    },
    "light": {
      "const": [
        -0.55,
        -0.75,
        0.7
      ]
    },
    "seed": {
      "type": "integer",
      "minimum": 0
    },
    "wear": {
      "enum": [
        "clean",
        "used",
        "worn"
      ]
    },
    "recipe_version": {
      "type": "string"
    },
    "render_mode": {
      "enum": [
        "procedural",
        "authored_template"
      ]
    },
    "material_overrides": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "bare_steel",
          "painted_metal",
          "aluminum",
          "plastic",
          "glass",
          "rubber",
          "wood",
          "leather",
          "fabric",
          "paper",
          "ceramic",
          "organic",
          "stone",
          "liquid"
        ]
      }
    },
    "originality_provenance": {
      "type": "string"
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "required": [
          "op",
          "material",
          "tone"
        ],
        "properties": {
          "op": {
            "enum": [
              "polygon",
              "ellipse",
              "line"
            ]
          },
          "material": {
            "enum": [
              "bare_steel",
              "painted_metal",
              "aluminum",
              "plastic",
              "glass",
              "rubber",
              "wood",
              "leather",
              "fabric",
              "paper",
              "ceramic",
              "organic",
              "stone",
              "liquid"
            ]
          },
          "tone": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "width": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8
          },
          "points": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 63
              }
            }
          },
          "box": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 63
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "archetype": {
            "const": "layered"
          }
        }
      },
      "then": {
        "required": [
          "layers",
          "originality_provenance"
        ]
      }
    }
  ],
  "description": "Runtime normalization additionally checks design/archetype compatibility, coordinate topology, ordered ellipse boxes, physical parts, finite JSON numbers and required representations. Schema validation is not art approval."
}
